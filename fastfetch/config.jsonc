{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "builtin"
	},
	"display": {
		"separator": "",
		"key": {
			"width": 13
		}
	},
	"modules": [
		{
			"type": "host",
			"key": "󰌢 host",
			"keyColor": "magenta"
		},
		{
			"type": "cpu",
			"key": "󰻠 cpu",
			"keyColor": "magenta"
		},
		{
			"type": "gpu",
			"key": "󰍛 gpu",
			"keyColor": "magenta"
		},
		{
			"type": "disk",
			"key": " disk",
			"keyColor": "magenta"
		},
		{
			"type": "memory",
			"key": "󰑭 memory",
			"keyColor": "magenta"
		},
		{
			"type": "swap",
			"key": "󰓡 swap",
			"keyColor": "magenta"
		},
		{
			"type": "display",
			"key": "󰍹 display",
			"keyColor": "magenta"
		},
		{
			"type": "poweradapter",
			"key": " power",
			"keyColor": "magenta"
		},
		{
			"type": "gamepad",
			"key": " gamepad",
			"keyColor": "magenta"
		},
		{
			"type": "bluetooth",
			"key": " bluetooth",
			"keyColor": "magenta"
		},
		{
			"type": "sound",
			"key": " sound",
			"keyColor": "magenta"
		},
		"break",
		{
			"type": "shell",
			"key": " shell",
			"keyColor": "white"
		},
		{
			"type": "terminal",
			"key": " terminal",
			"keyColor": "white"
		},
		{
			"type": "packages",
			"key": "󰏖 packages",
			"keyColor": "white"
		},
		"break",
		{
			"type": "os",
			"key": "{icon} distro",
			"keyColor": "blue"
		},
		{
			"type": "kernel",
			"key": " kernel",
			"keyColor": "blue"
		},
		{
			"type": "localip",
			"key": "󰩟 network",
			"compact": true,
			"keyColor": "blue"
		},
		{
			"type": "wifi",
			"key": " wifi",
			"format": "{ssid}",
			"keyColor": "blue"
		},
		"colors"
	]
}
