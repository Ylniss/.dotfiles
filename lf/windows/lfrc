# docs:
# https://github.com/gokcehan/lf/blob/master/doc.txt

# -------------- OPTIONS --------------

set shell pwsh

set filesep " "

# show hidden files
set hidden true

# number of items to scroll from cursor
set scrolloff 10

# turn on line numbers with relative position
set number true
set relativenumber true

# search with patterns * ? .
set globsearch true

# time interval to refresh directories (when external prcesses update them)
set period 1

# -------------- KEYMAPS --------------

# f5 to reload config file 
map <f-5> source ~\\AppData\\Local\\lf\\lfrc

# a to create file
map a %{{
  $file_name = Read-Host "File name"
  New-Item $file_name -ItemType File
}}

# A to create directory
map A %{{
  $dir_name = Read-Host "Directory Name"
  New-Item $dir_name -ItemType Directory
}}

# Y to copy file path
map Y &echo $env:fx | clip

# default open command opens in vertical pane on right side
cmd open %{{
    wezterm cli split-pane --right -- nvim $env:f
}}

# V to open file in nvim
map V $nvim $env:f

# H to toggle hidden files
map H set hidden!

# x to execute current file (must be executable)
map x $$env:f

# X to execute current file and wait for user before closing
map X !$env:f

# navigation
map gr cd ~/stuff/repo
map gd cd ~/downloads
map gs cd ~/stuff
