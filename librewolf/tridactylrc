" Sourced at startup by the native messenger, or with :source.

" Drop the settings Tridactyl stores in the browser, so this file is the only
" source of truth.
sanitise tridactyllocal tridactylsync

" base16 colors, written by tinted-theming/render-tridactyl.nu.
colorscheme colors

" Tridactyl cannot run on about: pages, so redirect the new tab.
set newtab https://duckduckgo.com

" Never let a page focus an input on load, so j and k scroll instead of typing.
set allowautofocus false

" Ctrl+I in a text field edits it in nvim. Tridactyl waits for the window to close.
set editorcmd wezterm start --always-new-process -- nvim %f

" Vertical tabs: J moves down the list, K moves up, as in vim.
bind J tabnext
bind K tabprev

" Hints: f opens the link in a background tab, F in the current tab.
bind f hint -b
bind F hint

" Release Ctrl+B, so Firefox gets it and toggles the bookmarks sidebar.
unbind <C-b>

" Go to: g. gh and gr replace the default home and reader binds.
bind gb fillcmdline bmarks -t
set completions.Bmark.autoselect false
bind gh tabopen https://github.com
bind gy tabopen https://youtube.com
bind gr tabopen https://reddit.com
bind gmz tabopen https://mail.google.com/mail/u/0/#inbox
bind gmj tabopen https://mail.google.com/mail/u/1/#inbox

" Current tab: Space.
bind <Space>m mute toggle
bind <Space>p pin
bind <Space>d tabdetach
