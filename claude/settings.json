{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git mv:*)",
      "Bash(xargs grep:*)",
      "Bash(dotnet format:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms'); [System.Windows.Forms.MessageBox]::Show('Claude needs your attention', 'Claude Code')\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | { read cmd; case \"$cmd\" in grep*|find*|cat*|ls*|head*|tail*|wc*|sort*|echo*|pwd*|which*|dotnet\\ build*|dotnet\\ test*|git\\ log*|git\\ diff*|git\\ status*|git\\ branch*) echo '{\"decision\":{\"behavior\":\"allow\"}}'; ;; *) echo '{\"decision\":{\"behavior\":\"ask\"}}'; ;; esac; }"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest"
}
